{
  "name": "something2-backend",
  "version": "1.0.0",
  "description": "Backend for Something2 Game Engine",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js --inspect",
    "migrate": "node-pg-migrate --ignore-pattern '(?!.*\\.js$).*'",
    "migrate:up": "node-pg-migrate up --ignore-pattern '(?!.*\\.js$).*'",
    "test": "node --test --test-timeout=420000",
    "sprites:gen": "node scripts/gen-sprites.js",
    "seed:gear": "node scripts/seed-gear-ladder.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.10.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
