# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
# Both forms are needed: the trailing-slash patterns match real directories, the
# bare ones also match a SYMLINK named node_modules. Scratchpad worktrees symlink
# these back to the main checkout, and without the bare patterns `git add -A`
# commits the symlink — which then replaces the real directory with a link to
# itself on checkout. That happened once; keep both.
node_modules/
node_modules
frontend/node_modules/
frontend/node_modules
backend/node_modules/
backend/node_modules

# Production builds
dist/
dist-ssr/
frontend/dist/

# Environment files
.env
.env.local
.env.*.local
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
# Agent worktrees live INSIDE the repo. Each is a full second checkout, and it
# is untracked, so a `git add -A` from the main checkout sweeps the whole thing
# into a commit. Same class of accident as the node_modules symlink above.
.claude/worktrees/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite
.vite/
frontend/.vite/

# Docker/Compose Data (if volumes are mapped to local dirs)
# postgres_data/
# minio_data/
.mcp.json

# SOMET-336: pgmigrations ledger backups written by scripts/repair-migration-order.js
backend/.migration-backups/

# SOMET-423: default Postgres data dir for the orangepi production stack when
# ORANGEPI_DATA_DIR is unset. Docker creates missing bind-mount sources as
# root, so this must never be committed.
.orangepi-data/
