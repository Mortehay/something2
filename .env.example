# something2 -- environment template.
#
#   cp .env.example .env
#
# .env is gitignored; this file is not, so never put a real secret here.
# Every value below is fake and safe to commit.

# --- Required -------------------------------------------------------------
# compose interpolates these with ${VAR:?...} and refuses to start the stack if
# any is missing. Any values work for local dev, EXCEPT JWT_SECRET: the
# backend's own boot-time guard (backend/src/auth/assertJwtSecret.js) DELIBERATELY
# REJECTS the value below -- it is 32+ characters (clears the length check) but is
# listed by name in KNOWN_PLACEHOLDERS, because a secret committed to a public repo
# must never be bootable. The backend will refuse to start until you replace it:
#   openssl rand -hex 32
# and put the result here (or in your real .env). This is true for BOTH stacks
# (compose/develop and compose/orangepi) -- the guard runs at every boot.

POSTGRES_PASSWORD=devpassword
JWT_SECRET=dev-jwt-secret-change-me-32-chars-min
MINIO_ROOT_PASSWORD=devminiopassword
SPRITE_GEN_SHARED_SECRET=dev-sprite-secret

# --- Object store (optional) ----------------------------------------------
# Sprites live in an S3-compatible bucket. Leave ALL of this unset and the
# backend talks to the MinIO in compose exactly as it always has -- these exist
# so a real host can point at R2, Supabase Storage, B2 or a hosted MinIO
# without a code change (SOMET-379).
#
# The browser never contacts the store: index.js streams objects through the
# backend, so a hosted bucket needs no CORS rules and no public read policy --
# only reachability from the backend.
#
# MINIO_ENDPOINT accepts a host, host:port, or a full URL. With a URL the
# scheme decides TLS (and the port defaults to 443), so https:// works on its
# own. MINIO_PATH_STYLE=true suits MinIO; most hosted services want false.
#
# MINIO_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_REGION=auto
# MINIO_PATH_STYLE=false
# MINIO_BUCKET=sprites

# --- Public tunnel (optional) ---------------------------------------------
# Only `make tunnel` reads these; leaving them blank costs nothing, and `make up`
# still works without them. See "Playing over the internet" in the README.
#
# NGROK_DOMAIN must be the domain ngrok ASSIGNED your account. On the free plan
# you cannot choose the name -- inventing one fails with ERR_NGROK_313, and a
# second tunnel on the same account fails with ERR_NGROK_334. If you do not know
# yours, run the agent with no domain and read `url=` from its log (README).

NGROK_AUTHTOKEN=2FaKeFaKeFaKeFaKeFaKeFaKeFa_1ThisIsNotARealNgrokToken
NGROK_DOMAIN=your-assigned-name.ngrok-free.dev

# --- Behind a reverse proxy (optional) ------------------------------------
# Read by the backend, not by compose. Leave both unset for a backend players
# reach directly: unset means "believe nobody", which is the only safe default.
#
# The rate limiters key on the client address. When something else terminates
# the connection -- Caddy, a tunnel agent -- that address is the proxy's, the
# SAME one for every player, so one shared bucket ends up rate-limiting the
# whole playerbase. These two vars tell the backend how to see past it.
#
# TRUST_PROXY is the NUMBER OF HOPS in front of the backend (or 'loopback', or
# a comma-separated subnet list). Count them: cloudflared -> caddy -> backend
# is 2. It is deliberately not a boolean -- trusting every X-Forwarded-For
# would let any client forge a fresh bucket per request, and the backend
# refuses TRUST_PROXY=true at startup for that reason.
#
# TRUST_CF_CONNECTING_IP=1 makes Cloudflare's CF-Connecting-IP header the
# authority instead. Cloudflare sets and overwrites it at the edge, so a client
# cannot choose it. Only turn it on when traffic really does arrive through
# Cloudflare; it does nothing unless TRUST_PROXY is also set.
#
# Orange Pi production stack (cloudflared -> caddy -> backend):
#   TRUST_PROXY=2
#   TRUST_CF_CONNECTING_IP=1
# `make tunnel` (ngrok, agent in front of the backend): TRUST_PROXY=1

TRUST_PROXY=
TRUST_CF_CONNECTING_IP=

# --- Host-side scripts and tests (optional) -------------------------------
# The CONTAINERS get their own DATABASE_URL and REDIS_URL from
# compose/develop/docker-compose.yml. These are for commands you run on the HOST, such
# as the backend test suites.
#
# A localhost URL here is safe even though this file is mounted into the backend
# container: the backend calls `require('dotenv').config()`, and dotenv does not
# override variables that are already set, so compose's container-internal value
# (db:5432) always wins inside the container.

DATABASE_URL=postgres://user:devpassword@localhost:15432/game_db
REDIS_URL=redis://localhost:16379/0

# Backend DB tests fall back to DATABASE_URL when this is unset -- meaning they
# run against your DEV database and can delete seeded data. Point it at a
# scratch database before running them, and create that database first.
TEST_DATABASE_URL=postgres://user:devpassword@localhost:15432/game_db_test

# --- Orange Pi production stack (compose/orangepi/) ONLY ------------------
# Nothing below this point is read by compose/develop -- these three exist
# purely for `compose/orangepi/docker-compose.yml`, which interpolates all
# three with ${VAR:?...} and refuses to start (or even `ps`/`logs`/`down`)
# without them. See "Production stack (local verification)" in the README.
#
# PUBLIC_URL is the public origin players reach (e.g. your cloudflared
# hostname). It is baked into the frontend bundle at BUILD time, so changing
# it needs `--build`, not just a restart.
#
# ALLOW_LOCALHOST_API_URL is a LOCAL-VERIFICATION-ONLY opt-out: the frontend
# build refuses to bake in a localhost/127.0.0.1 PUBLIC_URL by default (a
# bundle built that way would silently point every player at their own
# machine). Defaults empty (the guard stays active) so a plain `cp
# .env.example .env` can never ship a real deployment with it disabled --
# set it to 1 only while verifying against http://localhost:8080 locally.
#
# ORANGEPI_DATA_DIR is where Postgres's data volume lives. It must be an
# ABSOLUTE PATH OUTSIDE this repository -- provisioning empties the app
# directory, and data under it would be destroyed on every re-provision.

PUBLIC_URL=http://localhost:8080
ALLOW_LOCALHOST_API_URL=
ORANGEPI_DATA_DIR=/tmp/s2-orangepi-verify

# --- Orange Pi REMOTE OPERATION (make pi-*) -------------------------------
# Read only by compose/orangepi/scripts/*.sh on the WORKSTATION -- they ssh to
# the board and run the stack there. None of this is read by either compose
# file, and none of it is needed to bring the production stack up locally.
#
# Every script fails with the NAME of the first missing variable rather than a
# bare error, so an incomplete block is a one-line fix, not a hunt.

# The board. ORANGEPI_PASSWORD is used by exactly one step of exactly one
# script -- installing the workstation public key into authorized_keys during
# `make pi-keygen` -- and can be blanked immediately afterwards. Everything
# after that step is key-based, so no password is ever piped through `sudo -S`
# where it would sit in the board's process list.
ORANGEPI_ADDRESS=192.168.0.222
ORANGEPI_LOGIN=pi
ORANGEPI_PASSWORD=

# The workstation keypair. Generated by `make pi-keygen` if absent, and NEVER
# regenerated if present -- a silent regeneration would lock you out of the
# board. Keep it outside the repository; compose/orangepi/secrets/ is
# gitignored and is the default home for exactly that reason.
#
# If you work from a throwaway checkout (a git worktree under /tmp, say), point
# this at a path that survives a reboot instead -- ~/.ssh/orangepi_ed25519. The
# relative default resolves inside whichever checkout you are standing in, and
# a cleared /tmp takes the only key that reaches the board with it.
ORANGEPI_SSH_KEY=compose/orangepi/secrets/orangepi_ed25519

# The two directories the data-safety rule is built on, both paths ON THE BOARD.
#   APP_DIR   holds the clone and nothing else. Provisioning EMPTIES it.
#   DATA_DIR  holds Postgres's volume and the board's own .env. Provisioning
#             never touches it.
# provision.sh refuses to run when DATA_DIR resolves inside APP_DIR, after
# resolving symlinks -- without that guard a second `make pi-provision` would
# silently destroy every account and world on the box, and it would present as
# database corruption rather than as the operator error it is.
ORANGEPI_APP_DIR=/app
# NOTE: ORANGEPI_DATA_DIR is documented above, in the production-stack block.
# It is the same variable: the path is interpreted on whichever machine runs
# the stack, so it is the board's data root for `make pi-*` and a local
# scratch path when verifying compose/orangepi on this workstation.

# What the board runs. `orangepi` is the DEPLOYMENT branch and is never
# developed on directly: promotion is a pull request from main into it, which
# is the human gate in front of a publicly-reachable machine. GIT_REPOSITORY
# is cloned ANONYMOUSLY over https -- the repository is public, so the board
# holds no credential of any kind and none can leak into its git config.
ORANGEPI_BRANCH=orangepi
GIT_REPOSITORY=https://github.com/your-account/something2.git

# Shared secret for the CI-to-board deploy hook. The GitHub Actions workflow
# signs its request with it and the listener on the board verifies the
# signature, rejecting anything that does not match -- the endpoint is
# internet-reachable through the tunnel, so an unverified call would be a
# remote deploy trigger for anyone who found it. Generate with:
#   openssl rand -hex 32
# Leave EMPTY to keep the hook disabled; the listener refuses to start without
# it rather than running unauthenticated.
DEPLOY_HOOK_SECRET=

# --- Optional test/admin seed ---------------------------------------------
# The seed_test_player migration creates an account ONLY when SEED_TEST_USER is
# exactly "1" AND both admin values are set. Note "0" and "false" are strings
# and would both be truthy in a naive check, so the migration tests for "1"
# specifically -- anything else, including unset, seeds nothing.
# For a normal dev database, leave this off and use `make admin-password`.

SEED_TEST_USER=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Frozen Go engine (optional) ------------------------------------------
# engine/ is superseded by the Node authority in backend/src/authority/ and
# nothing in the running game uses it. Its container still starts and is inert.
# Compose falls back to these same defaults when the variables are absent, so
# omitting the whole block changes nothing.

ENGINE_TICK_HZ=60
ENGINE_FLUSH_INTERVAL=5m
ENGINE_IDLE_EVICT=10m
ENGINE_AOI_RADIUS=30
ENGINE_GRID_CELL_SIZE=4
LOG_LEVEL=info

# Present in some existing .env files but NOT read by compose: it hardcodes
# ENGINE_PORT=8080, and nothing interpolates ENGINE_SNAPSHOT_EVERY_N_TICKS.
# Listed only so you know they are inert rather than missing.
#ENGINE_PORT=8080
#ENGINE_SNAPSHOT_EVERY_N_TICKS=3

# --- Public deployment hardening (SOMET-381) --------------------------------
#
# CORS_ORIGINS: comma-separated origins allowed to call the API from a browser.
# EMPTY MEANS DENY CROSS-ORIGIN -- never "allow all". That is the correct value
# in production, where Caddy serves the frontend and the API on one origin so
# nothing preflights. Local dev IS cross-origin (vite :15173 -> API :13101) and
# compose/develop sets it for you; set it here only to override.
CORS_ORIGINS=
#
# REGISTRATION_MODE: open | invite | closed
#   open   - anyone may sign up (fine on a workstation)
#   invite - a valid, unspent code is required; mint with
#            `node scripts/invite-codes.js mint 5 --note "for alice"`
#   closed - the endpoint is refused; create accounts out of band
# The boot guard REFUSES TO START in production when this is unset, because an
# unset variable is not a decision.
REGISTRATION_MODE=open
