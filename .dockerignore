**/node_modules
frontend/node_modules
backend/node_modules

# Everything below is context the images never COPY. Excluding it keeps the
# tarball sent to the daemon small, which barely matters on a workstation and
# matters a great deal on the Pi's fallback build path over four A53 cores.
.git
docs
tools
**/__tests__
**/*.test.js
# The backend's test tree (helpers and fixtures, not just *.test.js) and the
# Python reference the world-gen port is tested against (SOMET-644): neither
# runs in an image. The dev image bind-mounts backend/ over /app, so dev
# containers still see both.
backend/tests
backend/tools/world_gen_ref

# Neither is COPYed by any Dockerfile today, but both would otherwise sit in
# the build context uploaded to the daemon on the Pi. Excluded now, before
# .env holds a real secret and before compose/orangepi/secrets/ (the spec's
# planned home for a generated deploy key) exists.
.env
compose/orangepi/secrets/

# Host git-helper socket/token (see tools/git-helper); also bind-mounted at runtime
backend/run/

# Local-only trees that sit at the repo root of a developer checkout. None is
# COPYed by any Dockerfile. `.worktrees` is the one that matters (SOMET-646): each
# sibling worktree is a full checkout with its own seeds, so on a workstation it
# put gigabytes into the build context; the CI path is a clean checkout and never
# had it. The rest are editor/tooling scratch and a one-off Plane export.
.worktrees
.claude
.superpowers
.history
.lh
.idea
.vscode
.vite
plane_backlog.json
